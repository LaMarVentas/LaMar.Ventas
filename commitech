<script>
const menuBtn=document.getElementById('menuBtn');
const menuPanel=document.getElementById('menuPanel');
menuBtn.addEventListener('click',()=>{const open=menuPanel.classList.toggle('open');menuBtn.setAttribute('aria-expanded',String(open));menuBtn.setAttribute('aria-label',open?'Cerrar menú':'Abrir menú');menuBtn.textContent=open?'×':'☰'});
function closeMenu(){menuPanel.classList.remove('open');menuBtn.setAttribute('aria-expanded','false');menuBtn.setAttribute('aria-label','Abrir menú');menuBtn.textContent='☰'}

// Buscador, filtros y favoritos del catálogo (sin carrito ni compras).
const productCards=[...document.querySelectorAll('.live-card')];
productCards.forEach(card=>{card.dataset.sold='false';card.querySelectorAll('.sold-control,.sold-badge').forEach(el=>el.remove());});

// Tema claro/oscuro: se conserva la elección en este navegador.
const themeToggle=document.getElementById('themeToggle');
try{if(localStorage.getItem('lamar-tema')==='oscuro')document.body.classList.add('dark-mode')}catch(e){}
function syncThemeButton(){themeToggle.textContent=document.body.classList.contains('dark-mode')?'☀ Tema claro':'☾ Tema oscuro'}
syncThemeButton();

const searchInput=document.getElementById('productSearch');
const sizeFilter=document.getElementById('sizeFilter');
const priceFilter=document.getElementById('priceFilter');
const favoritesOnly=document.getElementById('favoritesOnly');
const resultsCount=document.getElementById('resultsCount');
const totalProducts=document.getElementById('totalProducts');
const sortOrder=document.getElementById('sortOrder');
totalProducts.textContent='Catálogo: '+productCards.length+' prendas';
// El orden inicial del catálogo representa las prendas agregadas más recientemente primero.
productCards.forEach((card,index)=>{card.dataset.addedOrder=String(index)});
let favoriteIds=new Set();
try{favoriteIds=new Set(JSON.parse(localStorage.getItem('lamar-favoritos')||'[]'))}catch(e){favoriteIds=new Set()}
productCards.forEach((card,index)=>{
 const id='prenda-'+index;
 card.dataset.productId=id;
 const fav=document.createElement('button');fav.type='button';fav.className='favorite-btn';fav.setAttribute('aria-label','Agregar a favoritos');fav.setAttribute('aria-pressed','false');fav.innerHTML='♡';
 const syncFav=()=>{const active=favoriteIds.has(id);fav.classList.toggle('is-favorite',active);fav.innerHTML=active?'♥':'♡';fav.setAttribute('aria-pressed',String(active));fav.setAttribute('aria-label',active?'Quitar de favoritos':'Agregar a favoritos')};
 fav.addEventListener('click',e=>{e.stopPropagation();if(favoriteIds.has(id))favoriteIds.delete(id);else favoriteIds.add(id);try{localStorage.setItem('lamar-favoritos',JSON.stringify([...favoriteIds]))}catch(e){}syncFav();renderFeatured();applyProductFilters()});
card.appendChild(fav);syncFav();
});
// Destacadas: primero las prendas que el visitante guardó en favoritos.
// Para contar favoritos reales de todos los visitantes hace falta una base de datos compartida.
const featuredContainer=document.getElementById('featuredProducts');
function renderFeatured(){
 featuredContainer.innerHTML='';
 const selected=[...productCards].sort((a,b)=>Number(favoriteIds.has(b.dataset.productId))-Number(favoriteIds.has(a.dataset.productId))||Number(a.dataset.addedOrder)-Number(b.dataset.addedOrder)).slice(0,2);
 selected.forEach((card,index)=>{const button=document.createElement('button');button.type='button';button.className='featured-item';const img=card.querySelector('img');const title=card.querySelector('h3')?.textContent||'Prenda';const price=card.querySelector('.live-price')?.textContent||'';const isFavorite=favoriteIds.has(card.dataset.productId);button.innerHTML=`<img alt="" src="${img?.src||''}"><span><span class="featured-label">${isFavorite?'♥ Favorita':'Destacada'}</span><strong></strong><span class="featured-price"></span></span>`;button.querySelector('strong').textContent=title;button.querySelector('.featured-price').textContent=price;button.setAttribute('aria-label','Ver '+title);button.addEventListener('click',()=>openProductDetails(card));featuredContainer.appendChild(button)});
}
renderFeatured();

function applyProductFilters(){
 const query=(searchInput.value||'').trim().toLocaleLowerCase('es');const size=sizeFilter.value;const max=Number(priceFilter.value||0);let shown=0;
 const sortedCards=[...productCards].sort((a,b)=>{const pa=Number((a.dataset.precio||'0').replace(/\./g,''));const pb=Number((b.dataset.precio||'0').replace(/\./g,''));if(sortOrder.value==='price-low')return pa-pb;if(sortOrder.value==='price-high')return pb-pa;return Number(a.dataset.addedOrder)-Number(b.dataset.addedOrder)});sortedCards.forEach(card=>document.getElementById('productosCargados').appendChild(card));
 productCards.forEach(card=>{const name=card.querySelector('h3')?.textContent.toLocaleLowerCase('es')||'';const desc=card.querySelector('.live-card-body')?.textContent.toLocaleLowerCase('es')||'';const price=Number((card.dataset.precio||'0').replace(/\./g,''));const sizes=(card.dataset.talla||'').split('-');const matchQuery=!query||name.includes(query)||desc.includes(query);const matchSize=!size||sizes.includes(size);const matchPrice=!max||price<=max;const matchFav=!favoritesOnly.checked||favoriteIds.has(card.dataset.productId);const hideSold=(getSettings().sold||'mostrar')==='ocultar'&&card.dataset.sold==='true';const visible=matchQuery&&matchSize&&matchPrice&&matchFav&&!hideSold;card.hidden=!visible;if(visible)shown++});
 resultsCount.textContent=shown===1?'1 prenda encontrada':shown+' prendas encontradas';
}
[searchInput,sizeFilter,priceFilter,favoritesOnly,sortOrder].forEach(el=>el.addEventListener(el===searchInput?'input':'change',applyProductFilters));
document.getElementById('clearFilters').addEventListener('click',()=>{searchInput.value='';sizeFilter.value='';priceFilter.value='0';favoritesOnly.checked=false;sortOrder.value='newest';applyProductFilters()});
applyProductFilters();

const productModal=document.getElementById('productModal');
const closeProductModal=document.getElementById('closeProductModal');
const modalProductImage=document.getElementById('modalProductImage');
const modalProductThumbs=document.getElementById('modalProductThumbs');
function openProductDetails(card){
 const title=card.querySelector('h3')?.textContent?.trim()||'Prenda';
 const img=card.querySelector('img');
 const desc=card.querySelector('.live-card-body>p:nth-of-type(2)')?.textContent?.trim()||'Una prenda seleccionada para sumar estilo a todos los días.';
 document.getElementById('modalProductTitle').textContent=title;
 document.getElementById('modalProductBrand').textContent=card.dataset.marca||'No se sabe; consultanos';
 document.getElementById('modalProductModel').textContent=title;
 document.getElementById('modalProductSize').textContent=card.dataset.talla||'No especificado';
  document.getElementById('modalProductPrice').textContent='$'+(card.dataset.precio||'No especificado');
 const conditionEl=document.getElementById('modalProductCondition'); if(conditionEl) conditionEl.textContent=card.dataset.estado||'--';
 document.getElementById('modalProductColors').textContent=card.dataset.colores||'—';
 // Estado mostrado en la ficha, si el elemento existe.
 document.getElementById('modalProductDescription').textContent=desc;
 modalProductImage.src=img?.src||''; modalProductImage.alt=img?.alt||title;
 modalProductThumbs.replaceChildren();
 if(img){const thumb=document.createElement('img');thumb.src=img.src;thumb.alt='Ver foto principal de '+title;thumb.title='Foto principal';thumb.addEventListener('click',()=>{modalProductImage.src=thumb.src});modalProductThumbs.appendChild(thumb)}
 const extraPhotos=(card.dataset.gallery||'').split('||').filter(src=>src && src !== img?.src);extraPhotos.forEach((src,i)=>{const thumb=document.createElement('img');thumb.src=src;thumb.alt='Ver foto '+(i+2)+' de '+title;thumb.title='Foto '+(i+2);thumb.addEventListener('click',()=>{modalProductImage.src=src});modalProductThumbs.appendChild(thumb)});
 document.getElementById('modalGalleryNote').textContent=extraPhotos.length?'Hay '+(extraPhotos.length+1)+' fotos de esta prenda. Tocá las miniaturas para ver los detalles.':'Marca: '+(card.dataset.marca||'No se sabe; consultanos')+'. Si necesitás confirmar algún detalle, consultanos por Instagram.';
 productModal.classList.add('open');productModal.setAttribute('aria-hidden','false');document.body.style.overflow='hidden';closeProductModal.focus();
}
function closeProductDetails(){productModal.classList.remove('open');productModal.setAttribute('aria-hidden','true');document.body.style.overflow=''}
document.querySelectorAll('.live-card').forEach(card=>{card.addEventListener('click',e=>{if(e.target.closest('a'))return;openProductDetails(card)});card.addEventListener('keydown',e=>{if((e.key==='Enter'||e.key===' ')&&e.target===card){e.preventDefault();openProductDetails(card)}})});
closeProductModal.addEventListener('click',closeProductDetails);
document.getElementById('backToCatalog').addEventListener('click',closeProductDetails);
productModal.addEventListener('click',e=>{if(e.target===productModal)closeProductDetails()});
document.addEventListener('keydown',e=>{if(e.key==='Escape'&&productModal.classList.contains('open'))closeProductDetails()});
const modalContactLink=document.getElementById('modalContactLink');
if(modalContactLink) modalContactLink.addEventListener('click',closeProductDetails);





// Configuración integral: tema, tamaño de texto, animaciones, cuadrícula y vendidos.
const settingsModal=document.getElementById('settingsModal');
const settingIds=['settingTheme','settingText','settingAnimations','settingLayout'];
function getSettings(){try{return JSON.parse(localStorage.getItem('lamar-configuracion')||'{}')}catch(e){return {}}}
function applySettings(cfg){
 const theme=cfg.theme||'auto';let dark=theme==='oscuro';if(theme==='auto')dark=window.matchMedia&&window.matchMedia('(prefers-color-scheme: dark)').matches;
 document.body.classList.toggle('dark-mode',dark);document.body.classList.toggle('large-text',(cfg.text||'normal')==='grande');document.body.classList.toggle('no-animations',(cfg.animations||'si')==='no');document.body.classList.toggle('compact-grid',(cfg.layout||'normal')==='compacto');
 const toggle=document.getElementById('themeToggle');if(toggle){toggle.textContent=dark?'☀ Tema claro':'☾ Tema oscuro';toggle.setAttribute('aria-label',dark?'Cambiar a tema claro':'Cambiar a tema oscuro')}
 productCards.forEach(card=>{card.hidden=false;card.dataset.sold='false';card.querySelectorAll('.sold-badge,.sold-control').forEach(el=>el.remove())});
 if(typeof applyProductFilters==='function')applyProductFilters();
}
function loadSettingsForm(){const c=getSettings();document.getElementById('settingTheme').value=c.theme||'auto';document.getElementById('settingText').value=c.text||'normal';document.getElementById('settingAnimations').value=c.animations||'si';document.getElementById('settingLayout').value=c.layout||'normal'}
function saveSettings(){const c={theme:document.getElementById('settingTheme').value,text:document.getElementById('settingText').value,animations:document.getElementById('settingAnimations').value,layout:document.getElementById('settingLayout').value};try{localStorage.setItem('lamar-configuracion',JSON.stringify(c))}catch(e){}applySettings(c);document.getElementById('settingsStatus').textContent='Configuración guardada en este navegador.'}
document.getElementById('settingsToggle').addEventListener('click',()=>{loadSettingsForm();settingsModal.classList.add('open');settingsModal.setAttribute('aria-hidden','false')});
function closeSettings(){settingsModal.classList.remove('open');settingsModal.setAttribute('aria-hidden','true')}
document.getElementById('closeSettings').addEventListener('click',closeSettings);settingsModal.addEventListener('click',e=>{if(e.target===settingsModal)closeSettings()});document.getElementById('saveSettings').addEventListener('click',saveSettings);
document.getElementById('resetSettings').addEventListener('click',()=>{try{localStorage.removeItem('lamar-configuracion')}catch(e){}loadSettingsForm();applySettings({});document.getElementById('settingsStatus').textContent='Se restauró la configuración inicial.'});
// Botón rápido de tema sincronizado con el panel de configuración.
document.getElementById('themeToggle').addEventListener('click',()=>{const c=getSettings();c.theme=document.body.classList.contains('dark-mode')?'claro':'oscuro';try{localStorage.setItem('lamar-configuracion',JSON.stringify(c))}catch(e){}applySettings(c);loadSettingsForm()});
// Cada prenda tiene un número estable y puede marcarse como vendida desde su tarjeta.
productCards.forEach(card=>{card.dataset.sold='false';card.querySelectorAll('.sold-badge,.sold-control').forEach(el=>el.remove());try{localStorage.removeItem('lamar-vendido-'+(productCards.indexOf(card)+1))}catch(e){}});
// Aplicar configuración al iniciar; actualizar modo automático si cambia el tema del sistema.
applySettings(getSettings());if(window.matchMedia){window.matchMedia('(prefers-color-scheme: dark)').addEventListener?.('change',()=>{if((getSettings().theme||'auto')==='auto')applySettings(getSettings())})}


// Mejoras extra: panel de administración local, tema personalizable y galería a pantalla completa.
(function(){
 const $=id=>document.getElementById(id); const overlay=$('adminOverlay'); if(!overlay)return;
 let unlocked=false; const defaultPassword='';
 function getAdminPassword(){try{return localStorage.getItem('lamar-admin-password')||''}catch(e){return ''}}
 $('adminOpen').addEventListener('click',()=>{overlay.classList.add('open');overlay.setAttribute('aria-hidden','false');$('adminLogin').hidden=unlocked;$('adminWorkspace').hidden=!unlocked});
 function closeAdmin(){overlay.classList.remove('open');overlay.setAttribute('aria-hidden','true')}; $('adminClose').addEventListener('click',closeAdmin);overlay.addEventListener('click',e=>{if(e.target===overlay)closeAdmin()});
 $('setAdminPassword').addEventListener('click',()=>{const p=prompt('Creá una contraseña local para este navegador (no protege el HTML publicado):');if(!p||p.length<6){alert('Usá al menos 6 caracteres.');return}try{localStorage.setItem('lamar-admin-password',p);alert('Contraseña local guardada.')}catch(e){alert('No se pudo guardar la contraseña en este navegador.')}});
 $('adminLoginForm').addEventListener('submit',e=>{e.preventDefault();const saved=getAdminPassword();if(!saved){alert('Primero tocá “Configurar contraseña” para crear una.');return}if($('adminPassword').value!==saved){alert('Contraseña incorrecta.');return}unlocked=true;$('adminLogin').hidden=true;$('adminWorkspace').hidden=false;$('adminPassword').value=''});
 const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
 function nextCode(){let max=0;document.querySelectorAll('.live-card').forEach((c,i)=>{max=Math.max(max,Number(c.dataset.productId||0),i+1)});return String(max+1).padStart(3,'0')}
 function fileToData(file){return new Promise((resolve,reject)=>{const reader=new FileReader();reader.onload=()=>resolve(reader.result);reader.onerror=reject;reader.readAsDataURL(file)})}
 $('addProductForm').addEventListener('submit',async e=>{e.preventDefault();if(!unlocked)return;const files=[...$('newPhotos').files];if(!files.length){$('adminStatus').textContent='Elegí al menos una foto.';return}if(files.some(f=>f.size>5*1024*1024)){ $('adminStatus').textContent='Cada foto debe pesar menos de 5 MB.';return}try{const photos=await Promise.all(files.map(fileToData));const code=nextCode(),name=$('newName').value.trim(),price=String(Math.round(Number($('newPrice').value))),size=$('newSize').value.trim(),condition=$('newCondition').value,desc=$('newDescription').value.trim();const article=document.createElement('article');article.className='live-card';article.tabIndex=0;article.setAttribute('role','button');article.setAttribute('aria-label','Ver '+name);article.dataset.productId=code;article.dataset.talla=size;article.dataset.precio=price;article.dataset.estado=condition;article.dataset.marca='No se sabe; consultanos';article.dataset.sold='false';article.dataset.gallery=photos.slice(1).join('||');const img=document.createElement('img');img.src=photos[0];img.alt=name;img.loading='lazy';const body=document.createElement('div');body.className='live-card-body';body.innerHTML='<div class="eyebrow">ROPA INFANTIL · N.º '+code+'</div><h3>'+esc(name)+'</h3><p class="live-price">$'+Number(price).toLocaleString('es-AR')+'</p><p>'+esc(desc||name)+'</p><p class="product-consult">Talle '+esc(size)+' · '+esc(condition)+'</p>';article.append(img,body);$('productosCargados').appendChild(article);article.addEventListener('click',ev=>{if(!ev.target.closest('a')&&typeof openProductDetails==='function')openProductDetails(article)});article.addEventListener('keydown',ev=>{if(ev.key==='Enter'||ev.key===' '){ev.preventDefault();if(typeof openProductDetails==='function')openProductDetails(article)}});try{const all=JSON.parse(localStorage.getItem('lamar-extra-products')||'[]');all.push({code,name,price,size,condition,desc,photos});localStorage.setItem('lamar-extra-products',JSON.stringify(all))}catch(err){$('adminStatus').textContent='Prenda agregada a la vista, pero el navegador no pudo guardarla (posible límite de almacenamiento).';return}if(typeof applyProductFilters==='function')applyProductFilters();$('adminStatus').textContent='Prenda N.º '+code+' agregada y guardada en este navegador. Usá “Exportar catálogo actualizado” para descargar el HTML.';$('addProductForm').reset()}catch(err){$('adminStatus').textContent='No se pudieron procesar las fotos. Probá con imágenes más livianas.'}});
 // Rehidrata productos agregados localmente en este navegador.
 try{const extras=JSON.parse(localStorage.getItem('lamar-extra-products')||'[]');extras.forEach(item=>{if(document.querySelector('.live-card[data-product-id="'+item.code+'"]'))return;const article=document.createElement('article');article.className='live-card';article.tabIndex=0;article.setAttribute('role','button');article.dataset.productId=item.code;article.dataset.talla=item.size;article.dataset.precio=item.price;article.dataset.estado=item.condition;article.dataset.marca=item.brand||'No se sabe; consultanos';article.dataset.sold='false';article.dataset.gallery=(item.photos||[]).slice(1).join('||');const img=document.createElement('img');img.src=item.photos[0];img.alt=item.name;img.loading='lazy';const body=document.createElement('div');body.className='live-card-body';body.innerHTML='<div class="eyebrow">ROPA INFANTIL · N.º '+esc(item.code)+'</div><h3>'+esc(item.name)+'</h3><p class="live-price">$'+Number(item.price).toLocaleString('es-AR')+'</p><p>'+esc(item.desc||item.name)+'</p><p class="product-consult">Talle '+esc(item.size)+' · '+esc(item.condition)+'</p>';article.append(img,body);$('productosCargados').appendChild(article);article.addEventListener('click',e=>{if(!e.target.closest('a')&&typeof openProductDetails==='function')openProductDetails(article)});});}catch(e){}
 // Persistir color de acento y aplicar el tema a más elementos.
 const oldApply=window.applySettings; const accentInput=$('settingAccent');if(accentInput){try{accentInput.value=localStorage.getItem('lamar-accent')||'#171717'}catch(e){}accentInput.addEventListener('input',()=>{document.documentElement.style.setProperty('--custom-accent',accentInput.value);document.querySelectorAll('.instagram-link,.settings-actions button:first-child').forEach(el=>{if(!document.body.classList.contains('dark-mode'))el.style.backgroundColor=accentInput.value});try{localStorage.setItem('lamar-accent',accentInput.value)}catch(e){}});}
 try{const accent=localStorage.getItem('lamar-accent');if(accent&&accentInput){accentInput.value=accent;document.documentElement.style.setProperty('--custom-accent',accent)}}catch(e){}
 // Exportación de respaldo de las prendas agregadas (JSON, no modifica el HTML publicado).
 $('exportCatalog').addEventListener('click',()=>{try{const extras=JSON.parse(localStorage.getItem('lamar-extra-products')||'[]');const blob=new Blob([JSON.stringify({exportado:new Date().toISOString(),productos:extras},null,2)],{type:'application/json'});const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download='LaMar.Ventas_productos_respaldo.json';document.body.appendChild(a);a.click();a.remove();URL.revokeObjectURL(url);$('adminStatus').textContent='Respaldo JSON descargado. Esto guarda los productos agregados, pero no reconstruye automáticamente el HTML.'}catch(e){$('adminStatus').textContent='No se pudo exportar el respaldo.'}});
 // Galería completa con navegación entre todas las fotos disponibles.
 let gallerySources=[],galleryIndex=0;const full=$('galleryFullscreen'),fullImg=$('galleryFullImage');function showFull(i){if(!gallerySources.length)return;galleryIndex=(i+gallerySources.length)%gallerySources.length;fullImg.src=gallerySources[galleryIndex];full.classList.add('open');full.setAttribute('aria-hidden','false')}function closeFull(){full.classList.remove('open');full.setAttribute('aria-hidden','true')}
 $('modalProductImage').addEventListener('click',()=>{gallerySources=[$('modalProductImage').src,...[...$('modalProductThumbs').querySelectorAll('img')].map(x=>x.src)].filter((v,i,a)=>v&&a.indexOf(v)===i);showFull(0)});
 $('galleryClose').addEventListener('click',closeFull);$('galleryPrev').addEventListener('click',()=>showFull(galleryIndex-1));$('galleryNext').addEventListener('click',()=>showFull(galleryIndex+1));full.addEventListener('click',e=>{if(e.target===full)closeFull()});document.addEventListener('keydown',e=>{if(!full.classList.contains('open'))return;if(e.key==='Escape')closeFull();if(e.key==='ArrowLeft')showFull(galleryIndex-1);if(e.key==='ArrowRight')showFull(galleryIndex+1)});
})();

